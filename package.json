{
  "name": "threadflow-mcp",
  "version": "0.1.0",
  "description": "MCP server for X/Twitter thread workflows: validate threads, enforce drafts before scheduling/posting, and gate posting on the pre-spend kill rule when a marketing pre-flight score is supplied.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http --port 3003",
    "test": "npm run build && node --test test/server.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
